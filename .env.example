DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=example.ir,www.example.ir
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.ir,https://www.example.ir
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_SUBDOMAINS=1
DJANGO_HSTS_PRELOAD=0
DB_ENGINE=mysql
DB_NAME=cpanel_db_name
DB_USER=cpanel_db_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=
